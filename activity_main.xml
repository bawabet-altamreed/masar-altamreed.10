<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/lectureTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="جاري تحميل المحاضرة..."
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="12dp" />

    <io.livekit.android.renderer.SurfaceViewRenderer
        android:id="@+id/localVideo"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="جاري التحميل..."
        android:gravity="center"
        android:textSize="16sp"
        android:padding="12dp" />

    <Button
        android:id="@+id/startButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔴 بدء المحاضرة"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/switchCameraButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔄 تبديل الكاميرا"
        android:enabled="false"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/shareScreenButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📱 مشاركة شاشة الهاتف"
        android:enabled="false"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/stopShareButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⏹ إيقاف مشاركة الشاشة"
        android:enabled="false"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/endButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⏹ إنهاء المحاضرة"
        android:enabled="false"
        android:layout_marginTop="8dp" />

</LinearLayout>
